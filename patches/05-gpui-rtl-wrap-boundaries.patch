+    #[test]
+    fn test_wrap_right_to_left_text_in_logical_order() {
+        // Glyphs come in logical order and their positions decrease from the right edge.
+        let text = "אבג דהו";
+        let indices = [0, 2, 4, 6, 7, 9, 11];
+        let mut layout = make_layout(
+            indices
+                .iter()
+                .enumerate()
+                .map(|(position, index)| glyph_at((6 - position) as f32 * 10., *index))
+                .collect(),
+        );
+        layout.width = px(70.);
+        layout.len = text.len();
+        assert_eq!(
+            layout.compute_wrap_boundaries(text, px(40.), None, &mut WrapScratch::default()),
+            [WrapBoundary {
+                run_ix: 0,
+                glyph_ix: 4
+            }]

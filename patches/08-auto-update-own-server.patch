+/// Where the Hebrew build asks for updates: comma-separated servers, tried in order.
+/// Override at build time with `ZED_HEBREW_UPDATE_SERVER`.
+const HEBREW_UPDATE_SERVERS: &str = match option_env!("ZED_HEBREW_UPDATE_SERVER") {
+    Some(servers) => servers,
+    None => "https://zed-updates.shealtiel.link,https://updates-production-a2e2f7ae.up.railway.app",
+};
+
+/// Build number of this binary (set by CI as `ZED_HEBREW_BUILD`). The update server reports the
+/// newest build as version `0.0.<build>`, so the editor only has to compare build numbers.
+const HEBREW_BUILD: u64 = match option_env!("ZED_HEBREW_BUILD") {
+    Some(build) => match u64::from_str_radix(build, 10) {
+        Ok(build) => build,
+        Err(_) => 0,
+    },
+    None => 0,
+};

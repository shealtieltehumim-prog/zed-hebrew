+/// For every glyph (in logical order) of a wrapped line, the x position of the leftmost glyph of
+/// its visual line, or `None` when that visual line already runs left to right.
+fn rtl_slice_left_edges(
+    layout: &LineLayout,
+    wrap_boundaries: &[WrapBoundary],
+) -> Vec<Option<Pixels>> {
+    let mut positions = Vec::new();
+    let mut slice_starts = Vec::new();
+    let mut wraps = wrap_boundaries.iter().peekable();
+    for (run_ix, run) in layout.runs.iter().enumerate() {
+        for (glyph_ix, glyph) in run.glyphs.iter().enumerate() {
+            if wraps.peek() == Some(&&WrapBoundary { run_ix, glyph_ix }) {
+                wraps.next();
+                slice_starts.push(positions.len());
+            }
+            positions.push(glyph.position.x);
+        }
+    }
+    let mut result = vec![None; positions.len()];
+    let mut start = 0;
+    for end in slice_starts
+        .into_iter()
+        .chain(std::iter::once(positions.len()))
+    {
+        if let Some(slice) = positions.get(start..end)
+            && let Some(first) = slice.first()
+        {
+            let left_edge = slice.iter().copied().fold(*first, |a, b| a.min(b));
+            if left_edge != *first {
+                for entry in &mut result[start..end] {
+                    *entry = Some(left_edge);
+                }
+            }
+        }
+        start = end;
+    }
+    result
+}
